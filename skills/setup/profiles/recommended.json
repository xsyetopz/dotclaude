{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plans": {},
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "5",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "5",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1"
  },
  "fastMode": false,
  "fastModePerSessionOptIn": true,
  "maxEffortLevel": "high",
  "autoCompactWindow": 150000,
  "cleanupPeriodDays": 14,
  "enableArtifact": false,
  "disableBundledSkills": true,
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off"
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "crossSessionInbound": "hold",
  "model": "claude-opus-5-5",
  "availableModels": [
    "claude-opus-5-5",
    "claude-sonnet-5-5",
    "claude-haiku-4-5"
  ],
  "advisorModel": "claude-opus-5-5",
  "includeGitInstructions": false,
  "workflowKeywordTriggerEnabled": false,
  "workflowSizeGuideline": "medium",
  "enableAllProjectMcpServers": false,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Agent(general-purpose)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh discussion create *)",
      "Bash(gh discussion comment *)"
    ]
  }
}
