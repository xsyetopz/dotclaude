// Prompt files use semantic line breaks, so a sentence can pass 100 columns,
// and long commands, URLs, and frontmatter descriptions cannot wrap.
// Numbered
// steps keep their numbers, since prompts refer to them ("before step 3").
// A config here replaces the parent one, so it extends the shared rules.
{
  "extends": "../.markdownlint.jsonc",
  "MD029": { "style": "ordered" }
}
