{
  "description": "dotclaude hooks: module/index.mjs runs the guards, the subagent rules, and the prompt and compaction notes. pre-tool-use/ask-guarded-calls.mjs keeps the asks of the guards in auto mode, and asks before a call reaches a project with an AI policy. session-start/add-session-context.mjs adds the working rules. subagent-start/add-subagent-context.mjs gives each subagent the project AI policy clause",
  "modules": ["./module/index.mjs"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|WebFetch|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/ask-guarded-calls.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start/add-session-context.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/subagent-start/add-subagent-context.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
