{
  "description": "dotclaude: mod.mjs asks before a recursive rm outside the project folder, and before the first call of a session that reaches a GitHub repository of another owner with an AI policy. In auto mode, auto-mode-guard.mjs gives the same ask from a classic hook, because the classifier can approve an ask of a module. mod.mjs also makes the context_management section of the system prompt true when compaction is off.",
  "modules": ["./mod.mjs"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-mode-guard.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(sudo *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-mode-guard.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(xargs *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-mode-guard.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-mode-guard.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(git clone *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-mode-guard.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(curl *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-mode-guard.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(wget *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-mode-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-mode-guard.mjs\""
          }
        ]
      }
    ]
  }
}
