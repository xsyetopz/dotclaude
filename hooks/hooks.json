{
  "description": "dotclaude hooks: register.mjs runs the tool, SubagentStart, UserPromptSubmit, and PreCompact actions, and one dispatcher process runs each other event, one file per action (see hooks/dispatch.mjs)",
  "modules": ["./register.mjs"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.mjs",
              "SessionStart"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.mjs", "Stop"],
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.mjs", "StopFailure"],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.mjs",
              "SubagentStop"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.mjs",
              "PreModelSwitch"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.mjs",
              "PostModelSwitch"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.mjs",
              "ConfigChange"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.mjs",
              "TaskCompleted"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
